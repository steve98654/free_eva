---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../data/site';
const { links, rally } = site;
const gcal = rally
  ? 'https://calendar.google.com/calendar/render?' + new URLSearchParams({
      action: 'TEMPLATE',
      text: 'Free Eva rally',
      dates: `${rally.startUtc}/${rally.endUtc}`,
      details: 'Peaceful, respectful rally for Eva Xie. More at https://evaxie.us/free-eva/',
      location: rally.place,
    }).toString()
  : null;
const graphics = [
  { file: 'social-avatar', title: 'Profile picture', note: 'Square, for any social account', dark: true },
  { file: 'social-share-card', title: 'Share image', note: '1200×630 link preview and post image', dark: true },
  { file: 'social-banner-x', title: 'X / Twitter banner', note: '1500×500 header', dark: true },
  { file: 'social-banner-facebook', title: 'Facebook cover', note: '1640×624 cover photo', dark: true },
  { file: 'sticker-round', title: 'Round sticker', note: 'Print at 3 or 4 inches', dark: false },
  { file: 'print-stacked-transparent', title: 'Poster and shirt logo', note: 'Transparent, for printing on light or dark', dark: false },
  { file: 'logo-horizontal-dark', title: 'Logo, horizontal (dark)', note: 'For dark backgrounds', dark: true },
  { file: 'logo-horizontal-light', title: 'Logo, horizontal (light)', note: 'For white paper and slides', dark: false },
  { file: 'logo-stacked-dark', title: 'Logo, stacked', note: 'Square-ish lockup', dark: true },
  { file: 'logo-chinese-dark', title: 'Chinese lockup', note: '釋放謝翌 leads, for Chinese-language posts', dark: true },
  { file: 'mark', title: 'Emblem only', note: 'The yin-yang and thirteen stars', dark: false },
  { file: 'mono-black', title: 'One-color black', note: 'For photocopies, stamps and stencils', dark: false },
];

// Verified 2026-11-23 from senate.gov, house.gov and nj.gov.
const officials = [
  {
    name: "Sen. Cory Booker",
    role: "U.S. Senate, New Jersey",
    phones: [
      { label: "Washington, D.C.", tel: "(202) 224-3224" },
      { label: "Newark", tel: "(973) 639-8700" },
      { label: "Camden", tel: "(856) 338-8922" },
    ],
    form: "https://www.booker.senate.gov/contact/write-to-cory",
    formLabel: "Write to Sen. Booker",
  },
  {
    name: "Sen. Andy Kim",
    role: "U.S. Senate, New Jersey",
    phones: [
      { label: "Washington, D.C.", tel: "(202) 224-4744" },
      { label: "Barrington", tel: "(856) 757-5353" },
      { label: "Jersey City", tel: "(201) 377-0900" },
    ],
    form: "https://www.kim.senate.gov/contact/",
    formLabel: "Write to Sen. Kim",
  },
  {
    name: "Rep. Bonnie Watson Coleman",
    role: "U.S. House, NJ-12 (Princeton)",
    phones: [
      { label: "Washington, D.C.", tel: "(202) 225-5801" },
      { label: "Ewing", tel: "(609) 883-0026" },
    ],
    form: "https://watsoncoleman.house.gov/contact",
    formLabel: "Write to Rep. Watson Coleman",
    note: "Representative-elect Adam Hamawy takes this seat on January 3, 2027.",
  },
  {
    name: "Gov. Mikie Sherrill",
    role: "Office of the Governor of New Jersey",
    phones: [
      { label: "Trenton", tel: "(609) 292-6000" },
    ],
    form: "https://www-njlib.nj.gov/GOV_TRANS_APPLICANTS/BTCustomServlet",
    formLabel: "Write to the Governor",
  },
];
---
<Base title="Free Eva" description="Eva Xie, a Princeton PhD student, was detained by ICE on returning from a conference. Help bring her home.">
  <section class="page-hero">
    <div class="wrap">
      <p class="zh-title" lang="zh-Hant">釋放謝翌</p>
      <h1>Bring Eva home.</h1>
      <p class="lede">
        Eva Xie is a PhD student at Princeton University. She traveled from an academic conference, and on November 19, 2026,
        on her way home, she was detained by U.S. Immigration and Customs Enforcement at Ronald Reagan Washington National Airport.
        Every day she spends in detention is a day away from her research, her colleagues and her life.
      </p>
      <div class="btn-row">
        <a class="btn" href="#act">What you can do</a>
      </div>
    </div>
  </section>

  <section>
    <div class="narrow">
      <p class="eyebrow">What we know</p>
      <h2>Her story</h2>
      <p>
        Only confirmed details belong here. The campaign will update this page as facts are verified and as
        Eva and her family are comfortable sharing them.
      </p>
      <dl class="facts">
        <dt>Who</dt><dd>Eva Yi Xie (謝翌), PhD candidate, Princeton University</dd>
        <dt>Field</dt><dd>Neuroscience, Princeton Neuroscience Institute. She studies how multiple brain regions work together to support decision-making, combining computational models with experiments.</dd>
        <dt>Background</dt><dd>MIT graduate (2024) in computer science and mathematics, Princeton Centennial Fellow, with published research at ICML 2025 and NeurIPS 2025.</dd>
        <dt>Conference</dt><dd>Neuroscience 2026, the annual meeting of the Society for Neuroscience, November 14–18, 2026, at the Walter E. Washington Convention Center in Washington, D.C. On November 18 she presented a poster on how brain cells that track physical location may also track information used for decision-making.</dd>
        <dt>Detained</dt><dd>By ICE on November 19, 2026, at Ronald Reagan Washington National Airport, while returning from a conference</dd>
        <dt>Where now</dt><dd>ICE&#8217;s Caroline Detention Facility in Bowling Green, Virginia</dd>
        <dt>In the U.S.</dt><dd>Came to the United States with her family at age 14 and has lived here since.</dd>
      </dl>
    </div>
  </section>

  <section>
    <div class="narrow">
      <figure class="poem">
        <blockquote>
          <p class="poem-zh" lang="zh-Hant">床前明月光，疑是地上霜。<br />舉頭望明月，低頭思故鄉。</p>
          <p class="poem-en">Before my bed, bright moonlight,<br />like frost upon the ground.<br />I raise my head to see the moon,<br />and lower it, thinking of home.</p>
        </blockquote>
        <figcaption>Li Bai <span lang="zh-Hant">李白</span>, <cite lang="zh-Hant">靜夜思</cite> (<cite>Quiet Night Thoughts</cite>), Tang dynasty</figcaption>
      </figure>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">What we are asking</p>
      <h2>Our asks</h2>
      <div class="grid grid-3">
        <div class="card accent">
          <h3>Release her now</h3>
          <p class="muted">Release Eva from detention while any questions about her case are resolved. A graduate student with a home, a university and a community is not a flight risk or a danger.</p>
        </div>
        <div class="card accent">
          <h3>Due process</h3>
          <p class="muted">Full, prompt access to her attorney, her family and her consulate, and a clear written explanation of why she was detained.</p>
        </div>
        <div class="card accent">
          <h3>Let her finish</h3>
          <p class="muted">Let Eva return to Princeton and complete the work she came here to do, under whatever lawful process applies.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="act">
    <div class="narrow">
      <p class="eyebrow">Take action</p>
      <h2>How you can help today</h2>
      <ol class="actions">
        <li>
          <h3>Call your members of Congress</h3>
          <p>The U.S. Capitol switchboard at <a href="tel:+12022243121">(202) 224-3121</a> connects you to any senator or representative. Ask them to contact ICE on Eva's behalf and request her release. Be brief and polite: who you are, where you live, what you ask.</p>
          <div class="officials">
            {officials.map((o) => (
              <div class="official card">
                <h4>{o.name}</h4>
                <p class="muted role">{o.role}</p>
                <ul>
                  {o.phones.map((ph) => (
                    <li><span class="where">{ph.label}</span> <a href={`tel:+1${ph.tel.replace(/\D/g, "")}`}>{ph.tel}</a></li>
                  ))}
                </ul>
                <p class="write"><a href={o.form} rel="noopener">{o.formLabel}</a></p>
                {o.note && <p class="muted note">{o.note}</p>}
              </div>
            ))}
          </div>
          <div class="script">
            <p class="eyebrow">Suggested call script</p>
            <p>"Hello, my name is <em>[your name]</em> and I live in <em>[town], New Jersey</em>. I'm calling about Eva Xie, a Princeton PhD student detained by ICE. I'm asking the <em>[Senator / Representative / Governor]</em> to contact ICE on her behalf, ask for her release, and make sure she has prompt access to her lawyer and her family. I also support ICE doing its job with respect for the public it serves. Thank you."</p>
            <p class="muted">Not a New Jerseyan? Use the switchboard above to reach your own members of Congress with the same message.</p>
          </div>
        </li>
        <li>
          <h3>Sign the petition</h3>
          {links.petition
            ? <p><a href={links.petition}>Sign and share the petition.</a></p>
            : <Placeholder label="Petition link (set links.petition in src/data/site.ts)" />}
        </li>
        <li>
          <h3>Show up</h3>
          <p>Come to a rally, <a href={site.links.shop ?? "/shop/"} rel="noopener">wear the shirt</a>, and keep it peaceful and respectful. Our message is stronger when the way we say it matches what we are asking for.</p>
          {rally ? (
            <div class="rally">
              <p style="margin-top: 0.7rem;"><strong>{rally.when}</strong><br />{rally.place}</p>
              <p class="rally-links">
                <a class="btn" href={gcal} target="_blank" rel="noopener">Add to Google Calendar</a>
                <a class="btn" href={rally.ics} download="free-eva-rally.ics">Apple / Outlook (.ics)</a>
                <a class="btn" href={rally.maps} target="_blank" rel="noopener">Directions</a>
              </p>
              {links.rally && <p><a href={links.rally}>Event details.</a></p>}
            </div>
          ) : links.rally
            ? <p><a href={links.rally}>Event details.</a></p>
            : <Placeholder label="Rally date, time and place (set links.rally)" />}
        </li>
        <li>
          <h3>Get in touch</h3>
          <p>Want to volunteer, organize on your campus, or talk to the press? Email us at <a href={`mailto:${links.email}`}>{links.email}</a>.</p>
        </li>
      </ol>
    </div>
  </section>
  <section id="graphics">
    <div class="wrap">
      <p class="eyebrow">Graphics kit</p>
      <h2>Share the graphics</h2>
      <p class="muted kit-intro">
        Free to use for supporting Eva: profile pictures, banners, posters and shirts. Please don't change the
        colors or add to the emblem. Each item comes as a PNG and as an SVG that scales to any size.
      </p>
      <div class="btn-row">
        <a class="btn" href="/downloads/free-eva-graphics.zip" download>Download everything (.zip)</a>
        <a class="btn ghost" href="/downloads/brand-guide.png" download>Brand guide</a>
      </div>
      <ul class="kit">
        {graphics.map((g) => (
          <li class="card">
            <a class:list={['thumb', { light: !g.dark }]} href={`/downloads/${g.file}.png`} download>
              <img src={`/downloads/thumbs/${g.file}.webp`} alt={g.title} loading="lazy" />
            </a>
            <h3>{g.title}</h3>
            <p class="muted">{g.note}</p>
            <p class="dl">
              <a href={`/downloads/${g.file}.png`} download>PNG</a>
              <a href={`/downloads/${g.file}.svg`} download>SVG</a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.6rem 1.25rem; margin: 1.5rem 0; }
  .facts dt { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--orange); }
  .facts dd { margin: 0; }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr; gap: 0.15rem; } .facts dd { margin-bottom: 0.7rem; } }
  .poem { margin: 0; text-align: center; }
  .poem blockquote { border-left: 0; border-top: 3px solid var(--orange); border-bottom: 3px solid var(--orange); padding: 1.75rem 1.25rem; margin: 0; }
  .poem-zh { font-family: var(--font-zh); font-weight: 600; font-size: clamp(1.35rem, 4.2vw, 1.9rem); letter-spacing: 0.12em; line-height: 1.8; color: var(--orange); margin: 0 0 1rem; }
  .poem-en { font-style: italic; line-height: 1.6; margin: 0; }
  .poem figcaption { margin-top: 0.8rem; font-size: 0.9rem; opacity: 0.8; }
  .poem cite { font-style: normal; }
  .kit-intro { max-width: 60ch; }
  .kit { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .kit .card { display: flex; flex-direction: column; }
  .kit h3 { margin: 0.9rem 0 0.25rem; font-size: 1.05rem; }
  .kit .muted { font-size: 0.9rem; margin: 0 0 0.75rem; }
  .thumb { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 0.75rem; }
  .thumb.light { background: #fff; }
  .thumb img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .dl { margin-top: auto; display: flex; gap: 1rem; font-weight: 700; }
  .officials { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin: 1.25rem 0; }
  .official h4 { margin: 0; font-size: 1.05rem; }
  .official .role { margin: 0.15rem 0 0.6rem; font-size: 0.9rem; }
  .official ul { list-style: none; padding: 0; margin: 0 0 0.6rem; display: grid; gap: 0.25rem; }
  .official li { display: grid; grid-template-columns: 7.5rem auto; align-items: baseline; }
  .official .where { font-size: 0.88rem; opacity: 0.8; }
  .official ul a { white-space: nowrap; }
  .official .write { margin: 0; font-weight: 700; }
  .official .note { margin: 0.5rem 0 0; font-size: 0.85rem; }
  .script { border-left: 3px solid var(--orange); padding: 0.25rem 0 0.25rem 1rem; margin-top: 1rem; }
  .script p { margin: 0.4rem 0; }
  .rally-links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem !important; }
</style>
