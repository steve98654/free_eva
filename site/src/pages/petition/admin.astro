---
import Base from '../../layouts/Base.astro';
---
<Base title="Petition admin" description="Campaign tool for moderating the public list of petition signers." noindex>
  <section class="page-hero">
    <div class="narrow">
      <p class="eyebrow">Campaign team only</p>
      <h1 class="adm-h1">Moderate public names</h1>
      <p class="muted">
        Hide a public name that is spam, offensive or fake. The signature stays in the database and in the count;
        only the name disappears from the public list. Use the same token as the Google Sheet (EXPORT_TOKEN), or
        ADMIN_TOKEN if one is set.
      </p>
      <form id="tok-form" class="tok">
        <input id="tok" type="password" placeholder="Admin token" autocomplete="off" />
        <button class="btn" type="submit">Load</button>
      </form>
      <p id="adm-msg" class="muted small"></p>
      <ul id="adm-list" class="adm-list"></ul>
    </div>
  </section>
</Base>

<script>
  type Row = { id: number; name: string; city: string | null; state: string | null; signedAt: string; hidden: boolean };
  const tokInput = document.getElementById('tok') as HTMLInputElement;
  const msg = document.getElementById('adm-msg')!;
  const list = document.getElementById('adm-list')!;
  try { tokInput.value = sessionStorage.getItem('petition-admin') || ''; } catch { /* ignore */ }

  const auth = () => ({ authorization: `Bearer ${tokInput.value.trim()}` });

  async function load() {
    msg.textContent = 'Loading…';
    const res = await fetch('/api/petition/admin/signers', { headers: auth() });
    if (!res.ok) { msg.textContent = res.status === 401 ? 'Wrong token.' : `Error ${res.status}`; return; }
    try { sessionStorage.setItem('petition-admin', tokInput.value.trim()); } catch { /* ignore */ }
    const { signers } = (await res.json()) as { signers: Row[] };
    msg.textContent = `${signers.length} public signers (newest first, up to 500).`;
    list.replaceChildren(...signers.map(row));
  }

  function row(s: Row): HTMLLIElement {
    const li = document.createElement('li');
    if (s.hidden) li.classList.add('is-hidden');
    const text = document.createElement('span');
    text.textContent = `${s.name}${s.city || s.state ? ` · ${[s.city, s.state].filter(Boolean).join(', ')}` : ''} · ${new Date(s.signedAt).toLocaleString()}`;
    const b = document.createElement('button');
    b.className = 'btn ghost';
    b.textContent = s.hidden ? 'Show' : 'Hide';
    b.addEventListener('click', async () => {
      b.disabled = true;
      const res = await fetch('/api/petition/admin/visibility', {
        method: 'POST',
        headers: { ...auth(), 'content-type': 'application/json' },
        body: JSON.stringify({ id: s.id, hidden: !s.hidden }),
      });
      b.disabled = false;
      if (!res.ok) { msg.textContent = `Could not update (${res.status}).`; return; }
      s.hidden = !s.hidden;
      li.replaceWith(row(s));
    });
    li.append(text, b);
    return li;
  }

  document.getElementById('tok-form')!.addEventListener('submit', (e) => { e.preventDefault(); load(); });
  if (tokInput.value) load();
</script>

<style>
  .adm-h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .tok { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0; }
  .tok input { flex: 1 1 14rem; font: inherit; color: var(--white); background: var(--black); border: 1px solid var(--line); border-radius: 4px; padding: 0.6rem 0.8rem; }
  .tok .btn { cursor: pointer; }
  .adm-list { list-style: none; padding: 0; margin: 1rem 0; }
  .adm-list :global(li) { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); }
  .adm-list :global(li.is-hidden span) { text-decoration: line-through; color: var(--muted); }
  .adm-list :global(.btn) { padding: 0.35rem 0.8rem; font-size: 0.85rem; cursor: pointer; }
</style>
