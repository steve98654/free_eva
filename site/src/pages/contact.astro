---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const { links } = site;
const mail = (subject: string) => `mailto:${links.email}?subject=${encodeURIComponent(subject)}`;
---
<Base title="Contact · Free Eva" description="Contact the Free Eva campaign: volunteers, press, campus organizers and group orders.">
  <section class="page-hero">
    <div class="wrap">
      <p class="zh-title" lang="zh-Hant">聯絡我們</p>
      <h1>Get in touch.</h1>
      <p class="lede">One inbox for everything. We read every message and answer as quickly as we can.</p>
      <div class="btn-row">
        <a class="btn email" href={`mailto:${links.email}`}>{links.email}</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid contact-grid">
        <div class="card accent">
          <h3>Volunteer</h3>
          <p class="muted">Help at a rally, table on campus, translate, or organize at your own school.</p>
          <p><a href={mail('Volunteer')}>Email us about volunteering</a></p>
        </div>
        <div class="card accent">
          <h3>Press</h3>
          <p class="muted">Reporters and editors: tell us your outlet and deadline, and we'll connect you with the right person.</p>
          <p><a href={mail('Press inquiry')}>Send a press inquiry</a></p>
        </div>
        <div class="card accent">
          <h3>Campus and community groups</h3>
          <p class="muted">Student groups, departments and faith or community organizations that want to sign on or host with us.</p>
          <p><a href={mail('Organizing')}>Talk to an organizer</a></p>
        </div>
        <div class="card accent">
          <h3>Group orders</h3>
          <p class="muted">Shirts, stickers or buttons for a lab, a class or a rally.</p>
          <p><a href={mail('Group order')}>Ask about a group order</a> · <a href="/shop/">See the shop</a></p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="narrow">
      <p class="eyebrow">Find us</p>
      <h2>Fountain of Freedom</h2>
      <p>
        Our rallies gather at the Fountain of Freedom on Scudder Plaza, in front of Robertson Hall.<br />
        Washington Rd., Princeton, NJ 08540
      </p>
      <p><a href="https://www.google.com/maps/search/?api=1&query=Fountain+of+Freedom+Robertson+Hall+Princeton+NJ" rel="noopener">Open in Maps</a></p>
      <p class="muted">Online, use #FreeEva and <span class="zh" lang="zh-Hant">#釋放謝翌</span>, and share <strong>{site.domain}</strong>.</p>
    </div>
  </section>
</Base>

<style>
  .contact-grid { grid-template-columns: 1fr; }
  @media (min-width: 720px) { .contact-grid { grid-template-columns: 1fr 1fr; } }
  .btn.email { text-transform: none; letter-spacing: 0.02em; }
</style>
