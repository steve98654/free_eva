// Cloudflare Workers deploy config for evaxie.us.
// Workers Builds settings: root directory `site`, build command `npm run build`,
// deploy command `npx wrangler deploy`.
//
// The Worker (worker/index.ts) serves the static Astro build and the petition API
// under /api/*. Petition setup steps are in PETITION.md.
{
  "name": "free-eva",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },

  // Public settings. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, IP_SALT) are NOT kept here:
  // add them in the Cloudflare dashboard (Worker > Settings > Variables and Secrets, type "Secret").
  "vars": {
    "SITE_URL": "https://evaxie.us",
    "EMAIL_FROM": "Free Eva <petition@evaxie.us>",
    "EMAIL_REPLY_TO": "weare@geodesic.pro",
    // Turnstile site key (public). Leave empty to skip the spam check.
    "TURNSTILE_SITE_KEY": ""
  }

  // Petition database (D1). Schema: migrations/. See PETITION.md.
  ,"d1_databases": [
    {
      "binding": "DB",
      "database_name": "free-eva-petition",
      "database_id": "80335ba7-cd6b-4a27-af9b-817511cf8dbf",
      "migrations_dir": "migrations"
    }
  ]
}
